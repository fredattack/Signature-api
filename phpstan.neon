includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - app

    # Ignore errors (Eloquent generics limitations)
    ignoreErrors:
        - '#uses generic trait .* but does not specify its types#'
        - '#PHPDoc type array<int, string> of property .* is not covariant#'
        - '#should return .* but returns .*\$this\(#'
        - '#Generic type .* in PHPDoc tag @return does not specify all template types#'
        - '#return type with generic class .* does not specify its types: TKey, TValue#'
